# Strumenti per comporre il disco dell'immagine AOSP di Vetro sul Mac
# (tools/aosp/mkdisk.sh): sgdisk, mkfs.ext4, simg2img.
FROM debian:trixie-slim
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends gdisk e2fsprogs android-sdk-libsparse-utils \
 && rm -rf /var/lib/apt/lists/*
