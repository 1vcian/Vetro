# Tools to assemble the disk of the Vetro AOSP image on the Mac
# (tools/aosp/mkdisk.sh): sgdisk, mkfs.ext4, simg2img; fsck.erofs to extract files from the partitions (AIDL map).
FROM debian:trixie-slim
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends gdisk e2fsprogs android-sdk-libsparse-utils erofs-utils \
 && rm -rf /var/lib/apt/lists/*
