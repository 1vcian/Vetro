# kselftests for the M3 guest: they assume glibc, hence arm64 Debian (with
# static linking: the initramfs has no shared libraries).
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential make rsync libcap-dev libcap-ng-dev libnuma-dev libc6-dev \
    && rm -rf /var/lib/apt/lists/*
