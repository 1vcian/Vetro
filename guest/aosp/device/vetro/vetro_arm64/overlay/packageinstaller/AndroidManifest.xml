<?xml version="1.0" encoding="utf-8"?>
<!-- Static package installer overlay (ADR 0030): replaces the foreground
     of the adaptive icon (app_icon_foreground, the AOSP robot) with the Vetro
     V; the background stays the system accent colour. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="vetro.overlay.packageinstaller">
    <application android:hasCode="false" />
    <overlay
        android:targetPackage="com.android.packageinstaller"
        android:isStatic="true"
        android:priority="10" />
</manifest>
