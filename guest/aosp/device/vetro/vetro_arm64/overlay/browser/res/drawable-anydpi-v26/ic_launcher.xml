    <background>
        <color android:color="#FF16505A" />
    </background>
    <foreground>
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <path
                android:fillColor="#00000000"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="3"
                android:pathData="M32,54a22,22 0,1 0,44 0a22,22 0,1 0,-44 0z" />
            <path
                android:fillColor="#00000000"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="2.5"
                android:pathData="M45,54a9,22 0,1 0,18 0a9,22 0,1 0,-18 0z" />
            <path
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="2.5"
                android:pathData="M32,54L76,54M35,43L73,43M35,65L73,65" />
        </vector>
    </foreground>
</adaptive-icon>
