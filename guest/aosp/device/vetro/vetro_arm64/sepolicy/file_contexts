# File contexts of the Vetro arm64 board (ADR 0022).

/vendor/bin/vetro-files  u:object_r:vetro_files_exec:s0

# sysfs of the virt's virtio-mmio devices (0x0a000000 + k*0x200): the
# same types that Cuttlefish gives to the virtio-pci paths (shared/sepolicy/vendor).
/sys/devices/platform/a00[0-3][02468ace]00\.virtio_mmio/virtio[0-9]+/net(/.*)?  u:object_r:sysfs_net:s0
/sys/devices/platform/a00[0-3][02468ace]00\.virtio_mmio/virtio[0-9]+/block(/.*)?  u:object_r:sysfs_devices_block:s0
