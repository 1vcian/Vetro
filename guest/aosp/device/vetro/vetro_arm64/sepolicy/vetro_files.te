# Vetro file manager daemon (guest/kernel/initramfs/vetro-files.c,
# ADR 0020 and 0022): listens on virtio-vsock (port 5200) and reads and writes
# guest files on behalf of the host, as root.
type vetro_files, domain;
type vetro_files_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vetro_files)

# The listening socket and the host's connections.
allow vetro_files self:vsock_socket { create_socket_perms_no_ioctl listen accept };

# It must be able to read and write any user file (app data,
# /sdcard) preserving owner, mode and context: no narrow rule
# covers that without clashing with the neverallows of system/sepolicy.
# The domain is therefore permissive, and only in development builds; in a
# user build it stays confined to the rules above (and init does not start it:
# vetro-files.rc ties it to ro.debuggable=1).
userdebug_or_eng(`permissive vetro_files;')
