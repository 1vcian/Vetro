# init of the Vetro arm64 board, after Cuttlefish's init.cutf_cvm.rc.

on early-init
    # For boot logs comparable with QEMU (tools/aosp/compare).
    write /dev/kmsg "VETRO: vetro_arm64 board init"

on property:sys.boot_completed=1
    # Level 2: after boot the console prints only messages below 4.
    write /dev/kmsg "<2>VETRO: sys.boot_completed=1"
    # Screen always on (power "plugged in"): on a slow emulated CPU the
    # inactivity screen-off arrives before the home screen is drawn, and
    # analysis wants the screen visible.
    exec_background - system system -- /system/bin/settings put global stay_on_while_plugged_in 7

# Cuttlefish services that without its host (vsock, /dev/hvcN, simulators)
# exit or abort immediately and that init would restart every 5 s, with a tombstone
# on every crash (on a slow emulated CPU they eat up most of the time) and
# flags_health_check on every round. On the first restart they are stopped: they
# remain startable on demand (servicemanager) but no longer loop.
on property:init.svc.vendor.uwb_hal=restarting
    stop vendor.uwb_hal

on property:init.svc.vendor.threadnetwork_hal=restarting
    stop vendor.threadnetwork_hal

on property:init.svc.vendor.confirmationui_default=restarting
    stop vendor.confirmationui_default

on property:init.svc.nfc_hal_service=restarting
    stop nfc_hal_service

on property:init.svc.bt_socket=restarting
    stop bt_socket

on property:init.svc.seriallogging=restarting
    stop seriallogging
