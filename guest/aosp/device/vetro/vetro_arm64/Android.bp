// Modules of the Vetro arm64 board (docs/adr/0022-vetro-aosp-image.md).

soong_namespace {
}

// Vetro code and configuration: PolyForm Noncommercial 1.0.0
// (LICENSE.md of the repository, ADR 0004). Soong has no SPDX kind for
// this license: legacy_notice with the text alongside.
package {
    default_applicable_licenses: ["device_vetro_license"],
}

license {
    name: "device_vetro_license",
    visibility: [":__subpackages__"],
    license_kinds: ["legacy_notice"],
    license_text: ["LICENSE"],
}

prebuilt_etc {
    name: "fstab.vetro",
    src: "fstab.vetro",
    vendor: true,
}

prebuilt_etc {
    // Like Cuttlefish's fstab.cf.*.vendor_ramdisk (shared/config/Android.bp).
    name: "fstab.vetro.vendor_ramdisk",
    srcs: ["fstab.vetro"],
    dsts: ["fstab.vetro"],
    vendor_ramdisk: true,
}

// Branding (ADR 0030): static overlays in /product/overlay, resources only.

runtime_resource_overlay {
    // Default icon of apps without an icon: no robot.
    name: "VetroFrameworkOverlay",
    product_specific: true,
    manifest: "overlay/framework/AndroidManifest.xml",
    resource_dirs: ["overlay/framework/res"],
    // QuickSearchBox is the "Google" search widget that Launcher3 puts
    // on the first page (it is the global search activity; the field uses
    // hint_google). Without it, Launcher3 shows its neutral bar ("Search",
    // qsb_default_view). overrides removes it from the PRODUCT_PACKAGES inherited
    // from handheld_product.mk (main.mk, module-overrides).
    overrides: ["QuickSearchBox"],
}

runtime_resource_overlay {
    // Icon of the package installer: no robot.
    name: "VetroPackageInstallerOverlay",
    product_specific: true,
    manifest: "overlay/packageinstaller/AndroidManifest.xml",
    resource_dirs: ["overlay/packageinstaller/res"],
}
