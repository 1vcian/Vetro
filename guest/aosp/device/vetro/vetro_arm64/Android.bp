// Moduli della scheda Vetro arm64 (docs/adr/0022-immagine-aosp-di-vetro.md).

soong_namespace {
}

// Codice e configurazione di Vetro: PolyForm Noncommercial 1.0.0
// (LICENSE.md del repository, ADR 0004). Soong non ha un tipo SPDX per
// questa licenza: legacy_notice con il testo accanto.
package {
    default_applicable_licenses: ["device_vetro_license"],
}

license {
    name: "device_vetro_license",
    visibility: [":__subpackages__"],
    license_kinds: ["legacy_notice"],
    license_text: ["LICENSE"],
}

prebuilt_etc {
    name: "fstab.vetro",
    src: "fstab.vetro",
    vendor: true,
}

prebuilt_etc {
    // Come fstab.cf.*.vendor_ramdisk di Cuttlefish (shared/config/Android.bp).
    name: "fstab.vetro.vendor_ramdisk",
    srcs: ["fstab.vetro"],
    dsts: ["fstab.vetro"],
    vendor_ramdisk: true,
}

// Marchi (ADR 0030): overlay statici in /product/overlay, solo risorse.

runtime_resource_overlay {
    // Icona predefinita delle app senza icona: niente robot.
    name: "VetroFrameworkOverlay",
    product_specific: true,
    manifest: "overlay/framework/AndroidManifest.xml",
    resource_dirs: ["overlay/framework/res"],
    // QuickSearchBox è il widget di ricerca "Google" che Launcher3 mette
    // sulla prima pagina (è l'attività di ricerca globale; il campo usa
    // hint_google). Senza, Launcher3 mostra la sua barra neutra ("Search",
    // qsb_default_view). overrides lo toglie dai PRODUCT_PACKAGES ereditati
    // da handheld_product.mk (main.mk, module-overrides).
    overrides: ["QuickSearchBox"],
}

runtime_resource_overlay {
    // Icona del programma di installazione: niente robot.
    name: "VetroPackageInstallerOverlay",
    product_specific: true,
    manifest: "overlay/packageinstaller/AndroidManifest.xml",
    resource_dirs: ["overlay/packageinstaller/res"],
}
