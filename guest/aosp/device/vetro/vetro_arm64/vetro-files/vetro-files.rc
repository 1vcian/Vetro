# Demone del gestore dei file di Vetro (ADR 0020, 0022): vsock, porta 5200.
# Solo nelle build di sviluppo (root, dominio SELinux permissivo). oneshot:
# se esce (per esempio senza virtio-vsock) init non lo riavvia a ciclo, così
# il log resta confrontabile con quello di QEMU.
service vetro_files /vendor/bin/vetro-files
    class late_start
    user root
    group root
    disabled
    oneshot

on post-fs-data && property:ro.debuggable=1
    start vetro_files
