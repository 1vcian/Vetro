# Vetro file manager daemon (ADR 0020, 0022): vsock, port 5200.
# Only in development builds (root, permissive SELinux domain). oneshot:
# if it exits (for example without virtio-vsock) init does not restart it in a
# loop, so the log stays comparable with QEMU's.
service vetro_files /vendor/bin/vetro-files
    class late_start
    user root
    group root
    disabled
    oneshot

on post-fs-data && property:ro.debuggable=1
    start vetro_files
