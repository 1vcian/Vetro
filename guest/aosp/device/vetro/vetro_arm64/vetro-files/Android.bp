// Vetro file manager daemon (ADR 0020, 0022). The source is
// guest/kernel/initramfs/vetro-files.c of the Vetro repository: it is copied here
// by tools/aosp/sync.sh (not duplicated in guest/aosp).

cc_binary {
    name: "vetro-files",
    srcs: ["vetro-files.c"],
    vendor: true,
    // SQL on the guest's databases (ADR 0021): the initramfs build links the
    // official amalgamation statically; here AOSP's libsqlite (vendor
    // variant, without ICU) provides sqlite3.h and the engine.
    shared_libs: ["libsqlite"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
    init_rc: ["vetro-files.rc"],
}
