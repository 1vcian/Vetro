// Vetro file manager daemon (ADR 0020, 0022). The source is
// guest/kernel/initramfs/vetro-files.c of the Vetro repository: it is copied here
// by tools/aosp/sync.sh (not duplicated in guest/aosp).

cc_binary {
    name: "vetro-files",
    srcs: ["vetro-files.c"],
    vendor: true,
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
    init_rc: ["vetro-files.rc"],
}
