+
+// Vetro: the composition result is RGBA in memory (DRM_FORMAT_ABGR8888), but
+// on virtio-gpu without 3D the host resource behind every dumb buffer is
+// B8G8R8X8 (the kernel's virtio_gpu_mode_dumb_create uses
+// DRM_FORMAT_HOST_XRGB8888, whatever format the framebuffer is added with), so
+// the host shows red and blue swapped. With
+// ro.vendor.hwcomposer.display_framebuffer_format=bgra (Cuttlefish's
+// bootconfig property, androidboot.hardware.hwcomposer.
+// display_framebuffer_format) the frame is converted to BGRA before the flush.
+bool UsesBgraFramebuffer() {
+    static const bool bgra =
+        ::android::base::GetProperty("ro.vendor.hwcomposer.display_framebuffer_format", "") ==
+        "bgra";
+    return bgra;
 }
 
