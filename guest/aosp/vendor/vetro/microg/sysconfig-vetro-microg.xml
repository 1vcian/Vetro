<?xml version="1.0" encoding="utf-8"?>
<!--
  microG in the background: exempt from battery optimisations and from
  background service limits, as the notification service requires.
-->
<config>
    <allow-in-power-save package="com.google.android.gms"/>
    <allow-in-data-usage-save package="com.google.android.gms"/>
</config>
