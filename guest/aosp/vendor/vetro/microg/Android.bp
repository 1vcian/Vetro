// microG for Vetro: GmsCore and Companion (Apache 2.0), official releases
// downloaded by tools/aosp/sync.sh with a pinned sha256 (microg.lock) into
// prebuilt/, which is not committed. See docs/adr/0022-vetro-aosp-image.md.

package {
    default_applicable_licenses: ["vendor_vetro_microg_license"],
}

license {
    name: "vendor_vetro_microg_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
}

// The XML configuration files belong to Vetro (PolyForm Noncommercial 1.0.0,
// ADR 0004).
license {
    name: "vendor_vetro_microg_config_license",
    visibility: [":__subpackages__"],
    license_kinds: ["legacy_notice"],
    license_text: ["LICENSE"],
}

android_app_import {
    name: "VetroGmsCore",
    apk: "prebuilt/com.google.android.gms.apk",
    // targetSdkVersion 29 and v1 signature: the build uncompresses dex and JNI
    // libraries (priv-app) and strips the v2 block, and system apps are verified
    // without the protection against v2 stripping (skipVerify for the system
    // partition in InstallPackageHelper): the v1 signature is enough.
    presigned: true,
    privileged: true,
    product_specific: true,
    // <uses-library> entries of the manifest (aapt2 dump badging), checked by Soong.
    uses_libs: ["com.android.location.provider"],
    optional_uses_libs: [
        "org.apache.http.legacy",
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    required: [
        "privapp-permissions-vetro-microg.xml",
        "default-permissions-vetro-microg.xml",
        "sysconfig-vetro-microg.xml",
    ],
}

android_app_import {
    name: "VetroGmsCompanion",
    apk: "prebuilt/com.android.vending.apk",
    presigned: true,
    privileged: true,
    product_specific: true,
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-vetro-microg.xml",
    src: "privapp-permissions-vetro-microg.xml",
    licenses: ["vendor_vetro_microg_config_license"],
    sub_dir: "permissions",
    product_specific: true,
}

prebuilt_etc {
    name: "default-permissions-vetro-microg.xml",
    src: "default-permissions-vetro-microg.xml",
    licenses: ["vendor_vetro_microg_config_license"],
    sub_dir: "default-permissions",
    product_specific: true,
}

prebuilt_etc {
    name: "sysconfig-vetro-microg.xml",
    src: "sysconfig-vetro-microg.xml",
    licenses: ["vendor_vetro_microg_config_license"],
    sub_dir: "sysconfig",
    product_specific: true,
}
