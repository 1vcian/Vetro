# Frammento di configurazione del kernel guest di Vetro (M3).
# Si applica sopra `make allnoconfig` (arm64); il risultato minimo è salvato in
# guest/kernel/config/defconfig da tools/guest-kernel/build.sh.
# Macchina: la "virt" di QEMU con -cpu cortex-a53 (ARMv8.0, ADR 0005).
# SMP: su arm64 è sempre attivo (def_bool y); il guest gira con una CPU.
# Moduli: nessuno (allnoconfig li lascia spenti), tutto è compilato dentro.

# Scheduler e numero di CPU: 2 è il minimo ammesso da arm64.
CONFIG_NR_CPUS=2
CONFIG_HZ_100=y

# Avvio da initramfs esterno (-initrd), compresso con gzip.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# File system di base.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# Console: UART PL011 (ttyAMA0) con earlycon, virtio-console (hvc0).
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_PRINTK=y

# RTC PL031.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_DEV=y

# GICv3 e timer generico (arm64 li seleziona già; qui per documentarli).
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y

# Trasporto virtio-mmio (niente PCI: i dispositivi virtio della virt sono
# anche su mmio, e a Vetro bastano quelli).
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y

# virtio-blk.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y

# Rete minima e virtio-net.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
