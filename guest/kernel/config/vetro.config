# Configuration fragment for the Vetro guest kernel (M3).
# Applied on top of `make allnoconfig` (arm64); the minimal result is saved to
# guest/kernel/config/defconfig by tools/guest-kernel/build.sh.
# Machine: QEMU's "virt" with -cpu cortex-a53 (ARMv8.0, ADR 0005).
# SMP: always on for arm64 (def_bool y); the guest runs with one CPU.
# Modules: none (allnoconfig leaves them off), everything is built in.

# Scheduler and number of CPUs: 2 is the minimum allowed by arm64.
CONFIG_NR_CPUS=2
CONFIG_HZ_100=y

# Boot from an external initramfs (-initrd), gzip-compressed.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Basic file systems.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# Console: PL011 UART (ttyAMA0) with earlycon, virtio-console (hvc0).
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_PRINTK=y

# RTC PL031.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_DEV=y

# GICv3 and generic timer (arm64 already selects them; listed here to document them).
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y

# virtio-mmio transport (no PCI: the virt machine's virtio devices are
# also on mmio, and those are enough for Vetro).
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y

# virtio-blk.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y

# Minimal networking and virtio-net.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
# AF_PACKET sockets: BusyBox's DHCP client (udhcpc) uses them.
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y

# M5: graphics, input and vsock like Vetro's virtio-mmio devices
# (virtio-gpu 2D, virtio-input keyboard and tablet, virtio-vsock). DRM only,
# no fbdev emulation and no framebuffer console: the guest draws with
# dumb buffers (guest/kernel/initramfs/vetro-dev.c).
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# M5: boot from Android images (boot.img, vendor_boot, init_boot;
# crates/vetro-machine/src/android). The bootconfig block at the end of
# the initrd (/proc/bootconfig, `bootconfig` on the command line, like the
# GKI) and ramdisks compressed with legacy LZ4, the GKI ramdisk format.
CONFIG_BOOT_CONFIG=y
CONFIG_RD_LZ4=y

# M8: the file manager daemon (guest/kernel/initramfs/vetro-files.c,
# ADR 0020): inotify for live events, and xattrs on tmpfs, so the tests
# check that a write preserves the file's xattrs (including
# security.selinux, which without SELinux tmpfs keeps like any other xattr).
CONFIG_INOTIFY_USER=y
CONFIG_TMPFS_XATTR=y
